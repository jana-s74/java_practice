public class NQueens {

    static boolean isSafe(char[][] board, int row, int col) {

        for (int i = 0; i < row; i++)
            if (board[i][col] == 'Q')
                return false;

        return true;
    }

    static void solve(char[][] board, int row) {

        if (row == board.length) {
            System.out.println("Solution Found");
            return;
        }

        for (int col = 0; col < board.length; col++) {

            if (isSafe(board, row, col)) {

                board[row][col] = 'Q';

                solve(board, row + 1);

                board[row][col] = '.';
            }
        }
    }
}